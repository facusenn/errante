# ─────────────────────────────────────────────
# Ink.Studio — configuración. Copiar a .env y ajustar.
# ─────────────────────────────────────────────

# Clave de sesión de Flask. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-en-produccion

# Acceso al panel admin (opcional, pero sin ella el panel queda bloqueado).
# Se puede poner la clave en texto plano, o (recomendado) un hash de werkzeug:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('tu-clave'))"
ADMIN_PASSWORD=

# Base de datos. Vacío = SQLite local (instance/reservas.db).
# Para migrar a Postgres sin tocar código:
#   postgresql+psycopg://usuario:clave@host:5432/tattoo
DATABASE_URL=

# Dónde guardar las imágenes subidas (por defecto ./uploads).
# En Docker debe coincidir con el volumen montado en docker-compose.yml.
UPLOAD_FOLDER=

# Límite de subida en MB (por defecto 8).
MAX_CONTENT_MB=8

# ── Twilio / WhatsApp (opcional) ─────────────
# Sin estos datos la app sigue andando: muestra el link wa.me como fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp de Twilio asignado al estudio, con código de país, sin '+'.
# Ejemplo: 14155238886
TWILIO_WHATSAPP_FROM=
# Número de WhatsApp del estudio, con código de país, sin '+' ni espacios.
# Ejemplo Argentina: 5491100000000
WHATSAPP_STUDIO_NUMBER=

# ── Google Calendar (opcional) ───────────────
# Cuenta de servicio: ruta al JSON descargado de Google Cloud, o el contenido
# del JSON pegado en una sola línea.
# Acordate de compartir el calendario con el email de la cuenta de servicio.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID del calendario del estudio (ej: tatuador@studio.com o un calendario secundario).
GOOGLE_CALENDAR_ID=
# Huso horario de los turnos.
TIMEZONE=America/Argentina/Buenos_Aires
